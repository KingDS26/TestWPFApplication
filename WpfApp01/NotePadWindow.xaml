<Window x:Class="WpfApp01.NotePadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp01"
        mc:Ignorable="d"
        Title="NotePadWindow" Height="450" Width="800">
    <Grid ShowGridLines="True">
        <!--分行-->
        <Grid.RowDefinitions>
            <RowDefinition Height="20"/>
            <!--第一行-->

            <RowDefinition Height="20"/>
            <!--第二行-->

            <RowDefinition/>
            <!--第三行-->

            <RowDefinition Height="20"/>
            <!--第四行-->

        </Grid.RowDefinitions>

        <!--margin:设置边距，左上右下-->
        <!--
    <Button Grid.Column="0" Content="文件" HorizontalAlignment="Left" Width="60" Grid.Row="0"/>
    <Button Grid.Column="0" Content="编辑" HorizontalAlignment="Left" Margin="60,0,0,0" Width="60" Grid.Row="0"/>
    <Button Grid.Column="0" Content="查看" HorizontalAlignment="Left" Margin="120,0,0,0" Width="60" Grid.Row="0"/>
    <Button Grid.Column="0" Content="外观" HorizontalAlignment="Left" Margin="180,0,0,0" Width="60" Grid.Row="0"/>
    <Button Grid.Column="0" Content="设置" HorizontalAlignment="Left" Margin="240,0,0,0" Width="60" Grid.Row="0"/>
    -->

        <!--Orientation="Horizontal" -> 设置排列方式,从左到右-->
        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
            <Button Width="60" Content="文件"/>
            <Button Width="60" Content="编辑"/>
            <Button Width="60" Content="查看"/>
            <Button Width="60" Content="外观"/>
            <Button Width="60" Content="设置"/>
            <Button Width="60" Content="帮助"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal">
            <Button Width="30" Content="1"/>
            <Button Width="30" Content="2"/>
            <Button Width="30" Content="3"/>
            <Button Width="30" Content="4"/>
            <Button Width="30" Content="5"/>
            <Button Width="30" Content="6"/>
            <Button Width="30" Content="7"/>
            <Button Width="30" Content="8"/>
            <Button Width="30" Content="9"/>
        </StackPanel>

        <Grid Grid.Row="2" ShowGridLines="True">
            <!--对第三行进行分列操作-->
            <Grid.ColumnDefinitions >
                <ColumnDefinition Width="30"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!--相对于第三行创建的grid来说，这是第一行第一列-->
            <StackPanel Grid.Row="0" Grid.Column="0">
                <Button Content="2.1" Height="20" Background="White" FontStyle="Italic"/>
                <Button Content="2.2" Height="20" Background="White"/>
            </StackPanel>

            <!--TextWrapping="Wrap" 表示换行-->
            <TextBox Grid.Row="0" Grid.Column="1" TextWrapping="Wrap" FontFamily="Times New Roman" FontSize="16"/>

        </Grid>

        <Grid Grid.Row="3" ShowGridLines="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Button Grid.Row="0" Grid.Column="0" Content="行 4/11"/>
            <Button Grid.Row="0" Grid.Column="1" Content="列 2"/>
            <Button Grid.Row="0" Grid.Column="2" Content="列 3"/>
            <Button Grid.Row="0" Grid.Column="3" Content="列 4"/>
            <Button Grid.Row="0" Grid.Column="4" Content="列 5"/>
            <Button Grid.Row="0" Grid.Column="5" Content="列 6"/>
            <Button Grid.Row="0" Grid.Column="6" Content="列 7"/>
            <Button Grid.Row="0" Grid.Column="7" Content="列 8"/>
            <Button Grid.Row="0" Grid.Column="8" Content="列 9"/>
            <Button Grid.Row="0" Grid.Column="9" Content="列 10"/>

            <!--<StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
            <Button Content="行 1 / 14" HorizontalAlignment="Center" Background="white"/>
        </StackPanel>
        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
            <Button Content="列 2" HorizontalAlignment="Center" Background="white"/>
        </StackPanel>
        <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal">
            <Button Content="列 3" HorizontalAlignment="Center" Background="white"/>
        </StackPanel>-->
        </Grid>
    </Grid>
</Window>
